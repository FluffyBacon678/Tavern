; Mobile Tavern — medieval tavern / restaurant management sim
; Engine configuration. Targets Godot 4.7.x, exporting to Windows and Android.

config_version=5

[application]

config/name="Mobile Tavern"
config/description="A medieval tavern management and colony simulation."
config/version="0.10.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.055, 0.039, 1)
boot_splash/show_image=false

[autoload]

GameSettings="*res://src/autoload/game_settings.gd"
GameState="*res://src/autoload/game_state.gd"
AudioDirector="*res://src/autoload/audio_director.gd"
SceneRouter="*res://src/autoload/scene_router.gd"
IconStudio="*res://src/autoload/icon_studio.gd"
TouchTips="*res://src/autoload/touch_tips.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
; "canvas_items" scales the UI with the window while keeping crisp layout;
; "expand" lets taller/wider phone aspect ratios reveal more scene rather
; than letterboxing, which is what we want behind a full-bleed background.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

ui_cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":1,"pressure":0.0,"pressed":false,"script":null)
]
}
toggle_fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194342,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
debug_regenerate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":82,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

; GL Compatibility is the widest-support renderer on Android and is more than
; enough for a 2D sim. Swap to "mobile" only if we later need 2D lighting
; features it does not cover.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.039, 1)
anti_aliasing/quality/msaa_2d=0

[file_customization]

folder_colors={
"res://assets/": "green",
"res://docs/": "gray",
"res://src/": "blue"
}
